# Copy this to .env and fill in your values.
# All variables use the DORQ_ prefix.

# --- LLM providers (supply whichever you use) ---
# DORQ_OPENAI_API_KEY=sk-...
# DORQ_ANTHROPIC_API_KEY=sk-ant-...
# DORQ_GROQ_API_KEY=gsk_...

# --- Alpaca (required for backtesting) ---
# Passed per-request in the API body, not stored server-side.
# Get paper-trading keys at: https://app.alpaca.markets/paper-trading

# --- Local error monitoring (GlitchTip) ---
# GlitchTip runs at http://localhost:8010 via Docker Compose in ~/glitchtip/
# Admin UI: http://localhost:8010  (admin@localhost / dorqadmin123)
DORQ_SENTRY_DSN=http://ac025ee807fd4d73a13b38fb9e5ed7c1@localhost:8010/1
DORQ_SENTRY_ENVIRONMENT=development
DORQ_SENTRY_TRACES_SAMPLE_RATE=0.2

# --- App settings ---
# DORQ_DEBUG=false
# DORQ_LOG_LEVEL=info
# DORQ_CORS_ORIGINS=["*"]
