# Copy this to .env and fill in your values.
# All variables use the DORQ_ prefix.

# --- LLM: local Ollama on the host machine ---
# The server talks to a single Ollama instance via LiteLLM.
# DORQ_OLLAMA_MODEL is REQUIRED — no model is baked into the code. Set it to
# any tag your Ollama serves (`ollama pull <model>`), or a cloud tag proxied
# by your local ollama (`ollama signin` first). LLM features stay disabled
# (503) until it is set.
DORQ_OLLAMA_MODEL=
# DORQ_OLLAMA_BASE_URL=http://localhost:11434
# DORQ_LLM_TIMEOUT=600        # per-request LLM timeout, seconds

# --- Alpaca (required for backtesting) ---
# Read from the environment on the server — never sent by the client.
# Get paper-trading keys at: https://app.alpaca.markets/paper-trading
# DORQ_ALPACA_API_KEY=...
# DORQ_ALPACA_SECRET_KEY=...

# --- App settings ---
# DORQ_DEBUG=false
# DORQ_LOG_LEVEL=info       # debug | info | warning | error | critical
# DORQ_CORS_ORIGINS=["*"]
